{
  "name": "amazon-chime-sdk-js-demo",
  "version": "3.0.0",
  "description": "Amazon Chime SDK JavaScript Demo",
  "scripts": {
    "deps": "cd ../.. && npm run build",
    "lint": "eslint --ext .ts app vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "build:fast": "vite build --",
    "build": "npm run deps && npm install && npm run lint && tsc --noEmit && npm test && npm run build:fast",
    "start:fast": "node dev-server.js",
    "start:sdk-autorefresh": "SDK_AUTOREFRESH=true node dev-server.js",
    "start": "npm run deps && npm install && npm run start:fast"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "chokidar": "5.0.0",
    "happy-dom": "18.0.1",
    "lucide-static": "^1.61.0",
    "terser": "^5.47.1",
    "typescript": "~5.8.0",
    "vite": "^7.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-chime-sdk-media-pipelines": "^3.477.0",
    "@aws-sdk/client-chime-sdk-meetings": "^3.477.0",
    "@aws-sdk/client-chime-sdk-messaging": "^3.477.0",
    "@aws-sdk/client-ivs": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-sts": "^3.477.0",
    "amazon-chime-sdk-js": "file:../..",
    "compression": "^1.8.1",
    "uuid": "^11.1.1"
  },
  "license": "Apache-2.0",
  "overrides": {
    "fast-xml-parser": "5.7.1",
    "picomatch": "2.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/aws/amazon-chime-sdk-js"
  }
}
