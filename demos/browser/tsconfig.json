{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./build",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "isolatedModules": true,
    "declaration": false,
    "composite": false,
    "incremental": false
  },
  "include": [
    "./app/**/*",
    "./vite.config.ts",
    "./vitest.config.ts"
  ]
}
